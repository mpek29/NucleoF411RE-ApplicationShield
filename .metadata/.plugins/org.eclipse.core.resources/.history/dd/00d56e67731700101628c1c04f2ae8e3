#include "leds.h"

/* led RGB :
 *   LED_RED   --> PB4
 *   LED_GREEN --> PC7
 *   LED_BLUE  --> PA9
 */


void red_led(uint32_t on, uint8_t intensite)
{
    if (on)
    {
        // Calcul du duty cycle en fonction de l'intensité (0-100)
        uint32_t pwm_value = (intensite * TIM2->ARR) / 100;

        // Activer le timer pour la PWM
        HAL_TIM_PWM_Start(&htim2, TIM_CHANNEL_1);

        // Définir la valeur du duty cycle pour la LED
        __HAL_TIM_SET_COMPARE(&htim2, TIM_CHANNEL_1, pwm_value);
    }
    else
    {
        // Éteindre la PWM
        HAL_TIM_PWM_Stop(&htim2, TIM_CHANNEL_1);
    }
}

void green_led(uint32_t on)
{
    HAL_GPIO_WritePin(LED_GREEN_GPIO_Port, LED_GREEN_Pin, on ? GPIO_PIN_RESET : GPIO_PIN_SET);
}

void blue_led(uint32_t on)
{
    HAL_GPIO_WritePin(LED_BLUE_GPIO_Port, LED_BLUE_Pin, on ? GPIO_PIN_RESET : GPIO_PIN_SET);
}

void leds(uint16_t val)
{
    red_led((val & LED_RED) != 0, 50);
    green_led((val & LED_GREEN) != 0);
    blue_led((val & LED_BLUE) != 0);
}
