#ifndef INC_SW_H_
#define INC_SW_H_

void read_GPIO(GPIO_TypeDef* GPIOx, uint16_t GPIO_Pin){
	return HAL_GPIO_ReadPin(GPIOx, GPIO_Pin);
}

//SW_UP PA4
void sw_up(){
	return read_GPIO(GPIO_TypeDef* GPIOx, GPIO_PIN_4);
}

//SW_RIGHT PC0
void sw_right(){
	return read_GPIO(GPIO_TypeDef* GPIOx, GPIO_PIN_0);
}

//SW_LEFT PC1
void sw_left(){
	return read_GPIO(GPIO_TypeDef* GPIOx, GPIO_PIN_1);
}

//SW_DOWN PB0
void sw_down(){
	return read_GPIO(GPIO_TypeDef* GPIOx, GPIO_PIN_0);
}

